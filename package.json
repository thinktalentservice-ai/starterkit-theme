{
  "name": "@devopsnext/starterkit-theme",
  "version": "1.4.0",
  "description": "The two-brand semantic token engine — a brandable CSS token engine plus a MUI theme. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "presets",
    "bootstrap-bridge.css",
    "schema.json",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./mui": {
      "types": "./dist/mui.d.ts",
      "import": "./dist/mui.js",
      "require": "./dist/mui.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./bootstrap-bridge.css": "./bootstrap-bridge.css",
    "./presets/*.css": "./presets/*.css",
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "vitest run src/engine/fuzz.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "gen:tokens": "node scripts/gen-token-names.mjs",
    "gen:tokens:check": "node scripts/gen-token-names.mjs --check",
    "gen:presets": "node scripts/gen-preset-css.mjs",
    "gen:presets:check": "node scripts/gen-preset-css.mjs --check",
    "brand:emit": "node scripts/brand-emit.mjs --target=cdn",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "verify": "pnpm typecheck && pnpm gen:tokens:check && pnpm test && pnpm test:fuzz && pnpm build && pnpm gen:presets:check && pnpm smoke"
  },
  "peerDependencies": {
    "@mui/material": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "culori": "^4.0.2",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mui",
    "theme",
    "design-tokens",
    "design-system",
    "branding",
    "white-label",
    "semantic-tokens"
  ]
}
